      "name": "gstack",
      "repo": "garrytan/gstack",
      "license": "MIT",
      "author": "Garry Tan",
      "why": "visible-browser /qa, /review, /ship, /cso, /investigate and 60 more",
      "install": [
        "git clone --single-branch --depth 1 https://github.com/garrytan/gstack.git ~/.claude/skills/gstack && cd ~/.claude/skills/gstack && ./setup"
      ]
    },
    {
      "name": "ui-ux-pro-max",
      "repo": "nextlevelbuilder/ui-ux-pro-max-skill",
      "license": "MIT",
      "author": "Next Level Builder",
      "why": "UI/UX design intelligence (styles, palettes, font pairings)",
      "install": [
        "see https://github.com/nextlevelbuilder/ui-ux-pro-max-skill#installation"
      ]
    }
  ],
  "plugins": [
    {
      "name": "superpowers",
      "repo": "obra/superpowers",
      "license": "MIT",
      "author": "Jesse Vincent",
      "why": "process skills: systematic debugging, TDD, plans",
      "install": [
        "/plugin marketplace add obra/superpowers-marketplace",
        "/plugin install superpowers@superpowers-marketplace"
      ]
    },
    {
      "name": "claude-mem",
      "repo": "thedotmack/claude-mem",
      "license": "see repo",
      "author": "Alex Newman",
      "why": "persistent memory across sessions (check its current license)",
      "install": [
        "/plugin marketplace add thedotmack/claude-mem",
        "/plugin install claude-mem@thedotmack"
      ]
    },
    {
      "name": "vercel",
      "repo": "vercel/vercel-plugin",
      "license": "Apache-2.0",
      "author": "Vercel",
      "why": "Vercel deploys and platform docs",
      "install": [
        "/plugin install vercel@claude-plugins-official"
      ]
    },
    {
      "name": "skill-creator",
      "repo": "anthropics/claude-plugins-official/tree/main/plugins/skill-creator",
      "license": "Apache-2.0",
      "author": "Anthropic",
      "why": "write and evaluate your own skills",
      "install": [
        "/plugin install skill-creator@claude-plugins-official"
      ]
    }
  ]
}
